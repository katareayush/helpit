{
  "cli": {
    "version": ">= 16.3.2",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://admin.thehelpit.com/api/v1",
        "EXPO_PUBLIC_SOCKET_BASE_URL": "https://admin.thehelpit.com"
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://admin.thehelpit.com/api/v1",
        "EXPO_PUBLIC_SOCKET_BASE_URL": "https://admin.thehelpit.com"
      }
    },
    "production": {
      "autoIncrement": true,
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://admin.thehelpit.com/api/v1",
        "EXPO_PUBLIC_SOCKET_BASE_URL": "https://admin.thehelpit.com"
      }
    }
  },
  "submit": {
    "production": {}
  }
}